(defvar
  repress-timeout 180
  hold-delay 180
)

(deftemplate run (command)
  (cmd fish -c $command)
)

(deftemplate tap-holdy (tap-action hold-action)
  (tap-hold-release $repress-timeout $hold-delay $tap-action $hold-action)
)

(deftemplate layer (tap-action layer-name)
  (t! tap-holdy $tap-action (layer-while-held $layer-name))
)

;; Enterer kit (https://axlefublr.github.io/kanata-layers/)
;; Hold: add the layers given in `held` (component layer + composites on the way).
;; Release: tap the any-* vkey, which leaves every layer that logically requires
;; this key, no matter which enterer originally added it to the stack.
(deftemplate enter (key vkey-name held)
  (t! tap-holdy $key (multi $held (on-release tap-vkey $vkey-name)))
)

(deftemplate enter-mod (key vkey-name modifier held)
  (t! tap-holdy $key (multi $modifier $held (on-release tap-vkey $vkey-name)))
)

(deftemplate niri (action argument)
  (cmd "niri" "msg" "action" $action $argument)
)

