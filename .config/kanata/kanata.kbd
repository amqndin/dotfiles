(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  allow-hardware-repeat false
  concurrent-tap-hold yes
  log-layer-changes no
)

(defsrc)

(defvar
  repress-timeout 180
  hold-delay 180
)

(deftemplate layer (tap-action layer-name)
  (tap-hold-release $repress-timeout $hold-delay $tap-action (layer-while-held $layer-name))
)

(deftemplate tap-holdy (tap-action hold-action)
  (tap-hold-release $repress-timeout $hold-delay $tap-action $hold-action)
)

(deftemplate niri (action argument)
  (cmd "niri" "msg" "action" $action $argument)
)

(deflayermap (base)
  lmet (t! tap-holdy (layer-switch empty) lmet)
  spc (t! layer spc navigation)
  m (t! layer m mdown)
  v (t! layer v vdown)
  e (t! layer e edown)
  i (t! layer i idown)

  caps esc

  a (t! tap-holdy a lmet)  
  s (t! tap-holdy s lalt)  
  d (t! tap-holdy d lsft)  
  f (t! tap-holdy f lctl)  
                           
  j (t! tap-holdy j rctl)  
  k (t! tap-holdy k rsft)  
  l (t! tap-holdy l lalt)  
  ; (t! tap-holdy ; rmet)  

  left (tap-dance 300 (
    (cmd systemctl suspend)
    (cmd systemctl reboot)
    (cmd systemctl poweroff)
  ))
)

(deflayermap (idown)
  f (cmd wl-kbptr)
)

(deflayermap (mdown)
  f bspc
  d C-bspc
  s del
)

(deflayermap (vdown)
  k (cmd fish -c "~/dotfiles/scripts/internal/switch-audio-output.fish")
  j (cmd fnottctl dismiss-with-default-action)
  m (cmd fnottctl dismiss)
)

(deflayermap (edown)
  j (t! niri focus-workspace 1)
  k (t! niri focus-workspace 2)
  l (t! niri focus-workspace 3)
  ; (t! niri focus-workspace 4)
  i (t! niri focus-workspace 5)
  m (t! niri focus-workspace 6)
  o (t! niri focus-workspace 7)
  . (t! niri focus-workspace 8)
  , (t! niri focus-workspace 9)
  u (t! niri focus-workspace 10)
)

(deflayermap (empty)
  lmet (t! tap-holdy (layer-switch base) lmet)
)

(deflayermap (navigation)
  h left
  j down
  k up
  l rght

  u pgdn
  i pgup

  r lrld
  e caps
)
