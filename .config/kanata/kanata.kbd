(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  allow-hardware-repeat false
  concurrent-tap-hold yes
  log-layer-changes no
)

(defsrc)

(deflayermap (base)
  (t! layers)
  (t! disabled-keys)
  (t! homerow-mods)

  rmet (t! tap-holdy (layer-switch empty) rmet)
  caps esc
  right (t! power-control)
)

(deflayermap (i-down)
  f (t! run "stochos")
)

(deflayermap (m-down)
  f bspc
  d C-bspc
  s del
)

(deflayermap (v-down)
  k (cmd noctalia msg nightlight-force-toggle)
  j (cmd noctalia msg notification-invoke-latest)
  m (cmd noctalia msg notification-clear-active)
)

(deflayermap (f-down)
  e (t! enter e any-e (multi (layer-while-held e-down) (layer-while-held ef-down)))
  w (t! enter w any-w (multi (layer-while-held w-down) (layer-while-held fw-down)))
)

(deflayermap (e-down)
  f (t! enter f any-f (multi (layer-while-held f-down) (layer-while-held ef-down)))

  (t! focus-workspaces)
)

(deflayermap (ef-down)
  (t! move-to-workspaces)
)

(deflayermap (w-down)
  f (t! enter f any-f (multi (layer-while-held f-down) (layer-while-held fw-down)))

  (t! focus-columns)
)

(deflayermap (fw-down)
  (t! move-to-indices)
)

(deflayermap (empty)
  rmet (t! tap-holdy (layer-switch base) rmet)
)

(deflayermap (spc-down)
  h left
  j down
  k up
  l right

  u pgdn
  i pgup

  r lrld
  e caps
)

(include helpers.kbd)
(include internal.kbd)
