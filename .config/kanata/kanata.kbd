(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  allow-hardware-repeat false
  concurrent-tap-hold yes
  log-layer-changes no
)

(defsrc)

(defvar
  repress-timeout 180
  hold-delay 180

  tt $repress-timeout
  ht $hold-delay
)

(deftemplate layer (tap-action layer-name)
  (tap-hold-release $repress-timeout $hold-delay $tap-action (layer-while-held $layer-name))
)

(deftemplate tap-holdy (tap-action hold-action)
  (tap-hold-release $repress-timeout $hold-delay $tap-action $hold-action)
)

(deflayermap (base)
  lmet (layer-switch empty)
  spc (t! layer spc navigation)
  m (t! layer m mdown)
  v (t! layer v vdown)
  e (t! layer e edown)

  caps esc

  a (t! tap-holdy a lmet)  
  s (t! tap-holdy s lalt)  
  d (t! tap-holdy d lsft)  
  f (t! tap-holdy f lctl)  
                           
  j (t! tap-holdy j rctl)  
  k (t! tap-holdy k rsft)  
  l (t! tap-holdy l lalt)  
  ; (t! tap-holdy ; rmet)  

  left (tap-dance 300 (
    (cmd systemctl suspend)
    (cmd systemctl reboot)
    (cmd systemctl poweroff)
  ))
)

(deflayermap (mdown)
  f bspc
  d C-bspc
  s del
)

(deflayermap (vdown)
  k (cmd fish -c "~/dotfiles/scripts/internal/switch-audio-output.fish")
  j (cmd fish -c "fnottctl dismiss-with-default-action")
  m (cmd fish -c "fnottctl dismiss")
)

(deflayermap (edown)
  j (cmd fish -c "niri msg action focus-workspace 1")
  k (cmd fish -c "niri msg action focus-workspace 2")
  l (cmd fish -c "niri msg action focus-workspace 3")
  ; (cmd fish -c "niri msg action focus-workspace 4")
  i (cmd fish -c "niri msg action focus-workspace 5")
  o (cmd fish -c "niri msg action focus-workspace 7")
  m (cmd fish -c "niri msg action focus-workspace 6")
  . (cmd fish -c "niri msg action focus-workspace 8")
  , (cmd fish -c "niri msg action focus-workspace 9")
  u (cmd fish -c "niri msg action focus-workspace 10")
)

(deflayermap (empty)
  lmet (layer-switch base)
)

(deflayermap (navigation)
  h left
  j down
  k up
  l rght

  u pgdn
  i pgup

  r lrld
  e caps
)
