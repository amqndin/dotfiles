(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  allow-hardware-repeat false
  concurrent-tap-hold yes
  log-layer-changes no
)

(defsrc)

(deflayermap (base)
  (t! layers)
  (t! disabled-keys)
  (t! homerow-mods)

  rmet (t! tap-holdy (layer-switch empty) rmet)
  caps esc
  right (t! power-control)
)

(deflayermap (i-down)
  f (cmd fish -c mousefree)
)

(deflayermap (m-down)
  f bspc
  d C-bspc
  s del
)

(deflayermap (v-down)
  k (cmd fish -c "dms ipc call night toggle")
  j (cmd dms ipc call notif-follow follow)
  m (cmd dms ipc call notifications dismissAllPopups)
  u (cmd fish -c "brightness.fish -d 10")
  i (cmd fish -c "brightness.fish -i 10")
)

(deflayermap (f-down)
  e (t! tap-holdy e (t! two-layers e-down ef-down))
)

(deflayermap (e-down)
  f (t! tap-holdy f (t! two-layers f-down ef-down))

  (t! focus-workspaces)
)

(deflayermap (ef-down)
  (t! move-to-workspaces)
)

(deflayermap (empty)
  rmet (t! tap-holdy (layer-switch base) rmet)
)

(deflayermap (spc-down)
  h left
  j down
  k up
  l right

  u pgdn
  i pgup

  r lrld
  e caps
)

(include helpers.kbd)
(include internal.kbd)
