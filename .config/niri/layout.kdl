
workspace "terminal" {}

workspace "discord" {}

workspace "browser" {}

workspace "game" {}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="top-right"
    open-focused false
}

window-rule {
    match app-id="foot" at-startup=true
    open-on-workspace "terminal"
}

window-rule {
    match app-id="equibop"
    match app-id="discord"
    open-on-workspace "discord"
}

window-rule {
    match app-id="zen"
    open-on-workspace "browser"
}

window-rule {
    match app-id="Minecraft"
    match app-id="Hytale"
    match app-id="prismlauncher"
    match app-id="lunarclient"
    match app-id="Lunar Client"
    open-on-workspace "game"
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="awww-daemon"
    place-within-backdrop true
}
