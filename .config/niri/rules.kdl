// Layer rules

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="awww-daemon"
    place-within-backdrop true
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Window rules
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
    default-floating-position x=32 y=32 relative-to="top-right"
    open-focused false
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match app-id="kitty" at-startup=true
    open-on-workspace "terminal"
}

window-rule {
    match app-id="equibop"
    match app-id="discord"
    match app-id="telegram"
    open-on-workspace "discord"
}

window-rule {
    match app-id="firefox"
    open-on-workspace "browser"
}

window-rule {
    match app-id="Minecraft"
    match app-id="Hytale"
    match app-id="prismlauncher"
    match app-id="lunarclient"
    match app-id="Lunar Client"
    open-on-workspace "game"
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}
