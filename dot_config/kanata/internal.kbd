(deftemplate focus-workspaces ()
  ;; j (t! niri focus-workspace 1)
  ;; k (t! niri focus-workspace 2)
  ;; l (t! niri focus-workspace 3)
  ;; ; (t! niri focus-workspace 4)
  j (t! niri focus-workspace "terminal")
  k (t! niri focus-workspace "discord")
  l (t! niri focus-workspace "browser")
  ; (t! niri focus-workspace "game")
  i (t! niri focus-workspace 5)
  u (t! niri focus-workspace 6)
  o (t! niri focus-workspace 7)
  m (t! niri focus-workspace 8)
  , (t! niri focus-workspace 9)
  . (t! niri focus-workspace 10)
)

(deftemplate power-control ()
  (tap-dance 300 (
    (cmd systemctl suspend)
    (cmd systemctl reboot)
    (cmd systemctl poweroff)
  ))
)

(deftemplate move-to-workspaces ()
  ;; j (t! niri move-column-to-workspace 1)
  ;; k (t! niri move-column-to-workspace 2)
  ;; l (t! niri move-column-to-workspace 3)
  ;; ; (t! niri move-column-to-workspace 4)
  j (t! niri move-column-to-workspace "terminal")
  k (t! niri move-column-to-workspace "discord")
  l (t! niri move-column-to-workspace "browser")
  ; (t! niri move-column-to-workspace "game")
  i (t! niri move-column-to-workspace 5)
  u (t! niri move-column-to-workspace 6)
  o (t! niri move-column-to-workspace 7)
  m (t! niri move-column-to-workspace 8)
  , (t! niri move-column-to-workspace 9)
  . (t! niri move-column-to-workspace 10)
)
