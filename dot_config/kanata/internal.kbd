(deftemplate disabled-keys ()
  bspc XX
  esc XX
  left XX
  up XX
  down XX
)

(deftemplate homerow-mods ()
  a (t! tap-holdy a lmet)
  s (t! tap-holdy s lalt)
  d (t! tap-holdy d lsft)
  f (t! mod-layer f lctl f-down)

  j (t! tap-holdy j rctl)
  k (t! tap-holdy k rsft)
  l (t! tap-holdy l lalt)
  ; (t! tap-holdy ; rmet)
)

(deftemplate layers ()
  spc (t! layer spc spc-down)
  ;; spc (t! layer spc space)
  m (t! layer m m-down)
  v (t! layer v v-down)
  e (t! layer e e-down)
  i (t! layer i i-down)
)

