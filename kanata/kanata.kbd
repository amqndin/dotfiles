(defcfg
  process-unmapped-keys yes
)
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =   bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]   \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)

(defvar
  tap-timeout 150
  hold-timeout 150

  tt $tap-timeout
  ht $hold-timeout
)

(deftemplate double-tap-layer-switch (key layer-name)
  $key (tap-dance 200 (
    $key
    (layer-switch $layer-name)
    (macro $key $key $key)
  ))
)

(deflayermap (default)
  caps esc

  a (tap-hold-release $tt $ht a lmet)
  s (tap-hold-release $tt $ht s lalt)
  d (tap-hold-release $tt $ht d lsft)
  f (tap-hold-release $tt $ht f lctl)
  
  j (tap-hold-release $tt $ht j rctl)
  k (tap-hold-release $tt $ht k rsft)
  l (tap-hold-release $tt $ht l lalt)
  ; (tap-hold-release $tt $ht ; rmet) 

  (template-expand double-tap-layer-switch grv transparent)
  spc (tap-hold-release $tt $ht spc (layer-while-held extended))
)


(deflayermap (transparent)
  (template-expand double-tap-layer-switch grv default)
)

(deflayermap (extended)
  u pgdn
  i pgup

  h left
  j down
  k up
  l rght

  f lctl
  d lsft
  s lalt
  a lmet

  r lrld
  e caps
)

;; vim: set syntax=lisp
